{
  "name": "gmail-autoclassifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered Gmail auto-classifier: turns senders into labels and Gmail filters, after a human-reviewed preview.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"wait-on -t 180000 http://127.0.0.1:8787/api/health && npm run dev:web\"",
    "dev:api": "nodemon -L -P 500 -w src/server -w src/shared -e ts -i \"src/**/*.test.ts\" -x \"tsx src/server/index.ts\"",
    "dev:web": "vite",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "googleapis": "^183.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
