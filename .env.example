# ============================================================
#  Gmail AutoClassifier — local configuration
#  Optional: every value here can also be set from the web UI
#  (Settings tab). Environment variables act as defaults.
#  Copy this file to `.env` and fill in the values you need.
# ============================================================

# --- Server ---
PORT=8787
# Frontend origin (used for CORS in development)
WEB_ORIGIN=http://localhost:5173
# Where to store the SQLite database (relative to the project root)
DATA_DIR=./data

# ============================================================
#  Google OAuth
#  Create a project at https://console.cloud.google.com, enable
#  the "Gmail API", then create "Web application" OAuth credentials
#  and add this authorized redirect URI:
#      http://localhost:5173/api/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ============================================================
#  AI provider
#  Choose one: opencode | opencode-go | openai | mock
#  Can also be changed at runtime from the Settings tab.
# ============================================================
AI_PROVIDER=opencode

# --- OpenCode Go (hosted, no local server needed) ---
# Subscribe in the OpenCode Console and paste the API key.
# Endpoint: https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash

# --- OpenCode server (self-hosted) ---
# Run OpenCode as a server:  opencode serve
OPENCODE_BASE_URL=http://localhost:4096
# Optional model in "provider/model" form (e.g. opencode/claude-sonnet-4-5)
OPENCODE_MODEL=
# Optional key if the server requires authentication
OPENCODE_TOKEN=

# --- OpenAI-compatible (OpenAI, OpenRouter, Groq, Ollama, LM Studio...) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
#  Security
#  Key used to encrypt secrets at rest. Generate a long random
#  string, e.g.  openssl rand -hex 32
# ============================================================
SESSION_SECRET=change-me-in-production
