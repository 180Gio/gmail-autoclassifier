# ============================================================
#  Gmail AutoClassifier — configurazione locale
#  Copia questo file in `.env` e compila i valori.
# ============================================================

# --- Server ---
PORT=8787
# Origine del frontend (usata per CORS in sviluppo)
WEB_ORIGIN=http://localhost:5173
# Dove salvare il database SQLite (relativo alla root del progetto)
DATA_DIR=./data

# ============================================================
#  Google OAuth
#  Crea un progetto su https://console.cloud.google.com
#  Abilita la "Gmail API", poi crea credenziali OAuth di tipo
#  "Web application" e imposta come redirect URI:
#      http://localhost:5173/api/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ============================================================
#  Provider IA
#  Scegli quale provider usare (opencode | openai | mock).
#  Puoi anche cambiarlo a runtime dalla pagina Impostazioni.
# ============================================================
AI_PROVIDER=opencode

# --- OpenCode (HTTP API locale) ---
# Avvia OpenCode in modalità server:  opencode serve
OPENCODE_BASE_URL=http://localhost:4096
# Modello opzionale nel formato "provider/model" (es. opencode/claude-sonnet-4-5)
OPENCODE_MODEL=
# Token opzionale se il server richiede autenticazione
OPENCODE_TOKEN=

# --- OpenAI-compatibile (OpenAI, OpenRouter, Groq, Ollama, LM Studio...) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
#  Sicurezza
#  Chiave per firmare i cookie di sessione (genera una stringa
#  casuale lunga, es.  openssl rand -hex 32)
# ============================================================
SESSION_SECRET=change-me-in-production
